#!/usr/bin/env ruby
# frozen_string_literal: true

require "rubyshell"
require "pry"

Pry::Prompt.add(:arrow, "Arrow prompt", ["=> ", "=> "]) do |_context, _nesting, _pry, sep|
  Dir.pwd + sep
end
Pry.config.prompt = Pry::Prompt[:arrow]
Pry.config.print = proc do |out, value|
  out.puts value
end

Pry.config.hooks.add_hook(:before_eval, :rewrite_macros) do |code, pry|
  code.gsub!(/^([A-z0-9]+ )(\s+)?(.*)(\s+do)?/, '\1"\3"\4')
end

def z(path)
  cd(zoxide("query", path))
end

sh do
  Pry.start(
    binding,
    commands: Pry::CommandSet.new,
    quiet: true
  )
end

